<?xml version="1.0" encoding="utf-8"?>
<!-- A screen arrives: fades in while growing from 96%. GPU-only, no extra memory. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic" android:duration="240">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <scale android:fromXScale="0.96" android:toXScale="1" android:fromYScale="0.96" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
</set>
