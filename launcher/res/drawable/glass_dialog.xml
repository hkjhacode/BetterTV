<?xml version="1.0" encoding="utf-8"?>
<!-- The glassy look's dialogs: a dark frosted pane with a bright hairline edge (no blur on Android 9). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <shape android:shape="rectangle">
        <corners android:radius="22dp" />
        <gradient android:angle="270" android:startColor="#E62A2C34" android:endColor="#E0141519" />
        <stroke android:width="1dp" android:color="#4DFFFFFF" />
    </shape>
</inset>
